<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Hoy en Zunbeltz». Lo rellena WidgetHoyZunbeltz.kt con lo que deja
     la app (lib/servicios/widget_hoy.dart). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1"
            android:text="@string/widget_hoy_nombre"
            android:textColor="@color/zunbeltz_monte"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/actualizado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/zunbeltz_tinta_apagada"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/zunbeltz_linea" />

    <LinearLayout
        android:id="@+id/fila_alarmas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/widget_fila_alarma"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/icono_alarmas"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_alarma"
            android:tint="@color/zunbeltz_papel" />

        <TextView
            android:id="@+id/texto_alarmas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/zunbeltz_papel"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila_tareas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icono_tareas"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_tareas"
            android:tint="@color/zunbeltz_monte" />

        <TextView
            android:id="@+id/texto_tareas"
            android:text="@string/widget_hoy_abre_app"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/zunbeltz_tinta"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila_supresion"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icono_supresion"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_supresion"
            android:tint="@color/zunbeltz_monte" />

        <TextView
            android:id="@+id/texto_supresion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/zunbeltz_tinta"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila_tiempo"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icono_tiempo"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_tiempo"
            android:tint="@color/zunbeltz_monte" />

        <TextView
            android:id="@+id/texto_tiempo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/zunbeltz_tinta"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Empuja los botones abajo si sobra alto. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="8dp" />

    <LinearLayout
        android:id="@+id/fila_botones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/boton_aviso"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            
            android:background="@drawable/widget_boton_senal"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:text="@string/widget_boton_aviso"
            android:textColor="@color/zunbeltz_papel"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/boton_mover"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_boton"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:text="@string/widget_boton_mover"
            android:textColor="@color/zunbeltz_papel"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/boton_cura"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_boton"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:text="@string/widget_boton_cura"
            android:textColor="@color/zunbeltz_papel"
            android:textSize="13sp" />

    </LinearLayout>
</LinearLayout>
