{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1180px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "noche",
					"name": "Noche",
					"color": "#0A0618"
				},
				{
					"slug": "noche-media",
					"name": "Noche media",
					"color": "#140A2E"
				},
				{
					"slug": "violeta",
					"name": "Violeta",
					"color": "#4B2E83"
				},
				{
					"slug": "neon",
					"name": "Neón",
					"color": "#8A5CFF"
				},
				{
					"slug": "azul",
					"name": "Azul neón",
					"color": "#4DC9FF"
				},
				{
					"slug": "ambar",
					"name": "Ámbar",
					"color": "#E8B85C"
				},
				{
					"slug": "texto",
					"name": "Texto",
					"color": "#E6E0FF"
				},
				{
					"slug": "tenue",
					"name": "Texto tenue",
					"color": "#9E95C7"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "roboto",
					"name": "Roboto",
					"fontFamily": "Roboto, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Roboto",
							"fontWeight": "300",
							"fontStyle": "normal",
							"src": [
								"file:./assets/fonts/Roboto-Light.ttf"
							]
						},
						{
							"fontFamily": "Roboto",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [
								"file:./assets/fonts/Roboto-Regular.ttf"
							]
						}
					]
				},
				{
					"slug": "cormorant",
					"name": "Cormorant Garamond",
					"fontFamily": "\"Cormorant Garamond\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Cormorant Garamond",
							"fontWeight": "300 700",
							"fontStyle": "italic",
							"src": [
								"file:./assets/fonts/CormorantGaramond-Italic-Variable.ttf"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "pequena",
					"name": "Pequeña",
					"size": "0.9rem"
				},
				{
					"slug": "normal",
					"name": "Normal",
					"size": "1.05rem"
				},
				{
					"slug": "grande",
					"name": "Grande",
					"size": "1.35rem",
					"fluid": {
						"min": "1.2rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "titulo",
					"name": "Título",
					"size": "2.4rem",
					"fluid": {
						"min": "1.8rem",
						"max": "3rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"vw",
				"%"
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--noche)",
			"text": "var(--wp--preset--color--texto)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--roboto)",
			"fontWeight": "300",
			"fontSize": "var(--wp--preset--font-size--normal)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.2rem",
			"padding": {
				"left": "clamp(16px, 5vw, 72px)",
				"right": "clamp(16px, 5vw, 72px)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ambar)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--texto)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "300",
					"letterSpacing": "0.06em",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var(--wp--preset--color--texto)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--titulo)"
				}
			},
			"button": {
				"color": {
					"background": "transparent",
					"text": "var(--wp--preset--color--ambar)"
				},
				"border": {
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--ambar)",
					"radius": "999px"
				},
				"typography": {
					"letterSpacing": "0.12em",
					"textTransform": "uppercase"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "cabecera",
			"title": "Cabecera",
			"area": "header"
		},
		{
			"name": "pie",
			"title": "Pie",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "pagina-juego",
			"title": "Página del juego (sin título)",
			"postTypes": [
				"page"
			]
		}
	]
}